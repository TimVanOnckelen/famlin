# Mobile environment variables — copy to .env and fill in
# API base URL used before a server has been chosen in the app (users still
# enter/change the address on the login screen). Development convenience only.
#
# Use the address that reaches the backend FROM WHERE THE APP RUNS:
#   iOS simulator     http://localhost:3000
#   Android emulator  http://10.0.2.2:3000   (localhost there is the emulator)
#   physical device   http://<your-LAN-IP>:3000
EXPO_PUBLIC_API_URL=http://localhost:3000
