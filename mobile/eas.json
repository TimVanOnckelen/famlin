{
  "cli": {
    "version": ">= 9.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "ios": {
        "resourceClass": "m-medium"
      },
      "env": {
        "EXPO_PUBLIC_SCROLL_DIAGNOSTICS": "1"
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "ios": {
        "resourceClass": "m-medium"
      },
      "env": {
        "EXPO_PUBLIC_SCROLL_DIAGNOSTICS": "1"
      }
    },
    "production": {
      "environment": "production",
      "ios": {
        "resourceClass": "m-medium"
      }
    },
    "diagnostics": {
      "extends": "production",
      "env": {
        "EXPO_PUBLIC_SCROLL_DIAGNOSTICS": "1"
      }
    },
    "apk": {
      "extends": "production",
      "android": {
        "buildType": "apk"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6786783660"
      },
      "android": {
        "track": "production"
      }
    }
  }
}
