# Used by docker-compose.yml. All other settings are managed via /admin.
JWT_SECRET=change-this-to-a-secure-random-string-with-at-least-32-characters
POSTGRES_PASSWORD=change-this-to-a-secure-random-password

# Pin the backend image to a specific released version (e.g. 1.2.0) for
# deliberate, reviewed updates. Leave unset to track the rolling `latest` tag.
# FAMLIN_VERSION=latest

# Set to true only if famlin-backend sits behind a reverse proxy that sets
# (and overwrites, never merely appends) X-Forwarded-Proto/X-Forwarded-Host —
# e.g. nginx/Caddy/Traefik in front of it. Leave false for a direct/no-proxy
# deployment, otherwise a client could spoof its own origin.
TRUST_PROXY=false

# The supplied Compose file forwards these media storage variables to the backend.
# See backend/.env.example and docs/docs/maintenance.md for all S3/fallback env vars.
# STORAGE_DRIVER=local
# S3_BUCKET=famlin
# S3_ENDPOINT=https://s3.example.com
# S3_REGION=us-east-1
# S3_PREFIX=media
# S3_FORCE_PATH_STYLE=false
# STORAGE_FALLBACK_DRIVER=local
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_SESSION_TOKEN=
# STORAGE_FALLBACK_UPLOADS_DIR=/app/uploads
# STORAGE_FALLBACK_S3_BUCKET=
# STORAGE_FALLBACK_S3_ENDPOINT=
# STORAGE_FALLBACK_S3_REGION=us-east-1
# STORAGE_FALLBACK_S3_PREFIX=
# STORAGE_FALLBACK_S3_ACCESS_KEY_ID=
# STORAGE_FALLBACK_S3_SECRET_ACCESS_KEY=
# STORAGE_FALLBACK_S3_SESSION_TOKEN=
# STORAGE_FALLBACK_S3_FORCE_PATH_STYLE=false
