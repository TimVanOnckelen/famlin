{
  "name": "famlin-backend",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "description": "Fastify backend for Famlin",
  "license": "MIT",
  "keywords": [
    "famlin",
    "fastify",
    "prisma",
    "postgres"
  ],
  "scripts": {
    "dev": "nodemon",
    "build": "tsc && npm run build:admin",
    "build:admin": "cd admin && npm ci && npm run build",
    "start": "node dist/server.js",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "test:docker": "sh scripts/test-in-docker.sh",
    "lint": "eslint . --max-warnings 0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1162.0",
    "@aws-sdk/lib-storage": "^3.1162.0",
    "@fastify/cors": "^11.4.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.7",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/static": "^10.1.10",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "archiver": "^8.0.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.9",
    "expo-server-sdk": "^8.0.0",
    "fastify": "^5.12.8",
    "fastify-plugin": "^6.0.1",
    "i18next": "^26.7.2",
    "jose": "^6.2.15",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.3.1",
    "sharp": "0.34.5",
    "yauzl": "^3.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/archiver": "^8.0.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/yauzl": "^3.4.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "node-addon-api": "8.9.2",
    "node-gyp": "13.1.0",
    "nodemon": "^3.1.14",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5.5.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "fast-uri@^3.0.0": "^3.1.8",
    "fast-uri@^4.0.0": "^4.1.5",
    "js-yaml": "^4.3.2",
    "deepmerge-ts": "^8.0.2",
    "mysql2": "^3.24.4"
  }
}
