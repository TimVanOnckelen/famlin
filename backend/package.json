{
  "name": "famlin-backend",
  "version": "0.6.6",
  "private": true,
  "type": "module",
  "description": "Fastify backend for Famlin",
  "license": "MIT",
  "keywords": [
    "famlin",
    "fastify",
    "prisma",
    "postgres"
  ],
  "scripts": {
    "dev": "nodemon",
    "build": "tsc && npm run build:admin",
    "build:admin": "cd admin && npm ci && npm run build",
    "start": "node dist/server.js",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "test:docker": "sh scripts/test-in-docker.sh",
    "lint": "eslint ."
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/multipart": "^10.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.3",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "archiver": "^8.0.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "expo-server-sdk": "^3.10.0",
    "fastify": "^5.12.4",
    "fastify-plugin": "^6.0.0",
    "i18next": "^26.4.2",
    "jose": "^5.10.0",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.1.1",
    "sharp": "^0.35.4",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/archiver": "^8.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^26.5.1",
    "@types/nodemailer": "^6.4.15",
    "eslint": "^10.10.0",
    "globals": "^16.5.0",
    "nodemon": "^3.1.14",
    "prisma": "^7.10.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "fast-uri@^3.0.0": "^3.1.8",
    "fast-uri@^4.0.0": "^4.1.5",
    "js-yaml": "^4.3.2",
    "deepmerge-ts": "^8.0.2",
    "mysql2": "^3.24.4"
  }
}
