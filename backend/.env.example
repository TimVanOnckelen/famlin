# Minimale opstart-configuratie. Alle overige instellingen worden via /admin beheerd.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://famlin:famlin@famlin-db:5432/famlin?schema=public
JWT_SECRET=change-this-to-a-secure-random-string-with-at-least-32-characters
# Only set to true behind a reverse proxy that sets (and overwrites) X-Forwarded-*.
TRUST_PROXY=false
# Set to true for a read-only/demo instance: all POST/PUT/PATCH/DELETE requests
# are blocked except login/session endpoints.
READ_ONLY=false

# Media storage: local (default) or s3. Branding always stays in UPLOADS_DIR.
STORAGE_DRIVER=local
# S3_BUCKET=famlin
# S3_ENDPOINT=https://s3.example.com
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_SESSION_TOKEN=
# S3_PREFIX=media
# S3_FORCE_PATH_STYLE=false
# Without explicit keys, the standard AWS credential chain is used.
# Online migration: previous storage remains readable until cleanup.
# STORAGE_FALLBACK_DRIVER=local
# STORAGE_FALLBACK_UPLOADS_DIR=/app/uploads
# For S3 -> local, use STORAGE_FALLBACK_DRIVER=s3 and the same S3 settings
# prefixed STORAGE_FALLBACK_ (e.g. STORAGE_FALLBACK_S3_BUCKET).
